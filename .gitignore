# python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# duckdb warehouse: полностью воспроизводим (just seed + sqlmesh run), не в git
warehouse/*.duckdb
warehouse/*.duckdb.wal
warehouse/*.duckdb.tmp
warehouse/queries.log

# sqlmesh state
.sqlmesh/

# build artifacts
*.egg-info/


# node
node_modules/

# cube dev-кэши
packages/cube/.cube/
packages/cube/.cubestore/

# evidence build cache
packages/evidence/.evidence/

# misc
.DS_Store
*.log

# sqlmesh local cache
.cache/

# harness ground-truth query log (report в git)
artifacts/duckdb_query_log.csv

# stack.sh runtime: pid-файлы и логи серверов
artifacts/run/
artifacts/logs/

# бэкапы БД от транзакционного rebuild (удаляются при успехе, живут на случай сбоя)
warehouse/*.duckdb.bak.*
