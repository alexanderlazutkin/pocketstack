# pocketstack — переменные окружения (секреты)
#
# Скопируйте в .env и заполните:            cp .env.example .env
# Файл .env в git НЕ попадает (.gitignore).
# Без .env стек не стартует — код не содержит кредов и фолбэков (security).

# --- Cube REST API (:4000) ---------------------------------------------------
# Токен авторизации Cube REST/GraphQL: заголовок Authorization для harness
# (`just verify` / `just bench`) и доступа к Cube UI API.
# Сгенерируйте свой:  openssl rand -hex 32
CUBEJS_API_SECRET=change-me-generate-openssl-rand-hex-32

# --- Cube SQL API, pg-wire (:15432) -----------------------------------------
# Логин/пароль подключения по протоколу PostgreSQL: DBeaver/DBX
# (docs/cube-sql-clients.md), Evidence-материализация (connection.yaml),
# harness SQL API-путь.
# Пароль сгенерируйте свой:  openssl rand -hex 32
CUBESQL_USER=pocketstack
CUBESQL_PASSWORD=change-me-generate-openssl-rand-hex-32

# --- Необязательные (значения по умолчанию — разумные локальные) -------------
# База и порты (используются harness; менять не требуется)
# CUBEJS_URL=http://localhost:4000
# CUBESQL_HOST=localhost
# CUBESQL_PORT=15432
