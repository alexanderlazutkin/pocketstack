name: cube
type: postgres
description: Cube semantic layer через SQL API (pg-wire :15432) — единые метрики для всех дашбордов
# ШАБЛОН: реальный connection.yaml генерируется из .env скриптом
# scripts/render-evidence-connection.sh (вызывается stack.sh/just автоматически).
# Placeholders заменяются на CUBESQL_USER / CUBESQL_PASSWORD.
options:
  host: localhost
  port: 15432
  user: __CUBESQL_USER__
  password: __CUBESQL_PASSWORD__
  database: default
